# Corgi Style Frontend Environment Configuration
# Copy this file to .env.local and configure as needed

# ===================
# API Configuration
# ===================

# 后端 API 地址（当 USE_MOCK=true 时不生效）
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===================
# Mock Mode Configuration
# ===================

# 是否使用 Mock 数据模式
# true = 使用本地模拟数据，不依赖后端服务
# false = 连接真实后端服务（需要启动 service 层）
NEXT_PUBLIC_USE_MOCK=false

# ===================
# Weather API (和风天气)
# ===================

# 和风天气 API Key（用于获取真实天气数据）
# 申请地址: https://dev.qweather.com/
# 当 USE_MOCK=true 时不需要配置
# QWEATHER_API_KEY=your_api_key_here
# QWEATHER_API_HOST=https://devapi.qweather.com

# ===================
# Notes
# ===================
# 启动开发服务器后访问 http://localhost:3000
#
# Mock 模式下：
# - 天气数据使用预设的上海数据（22°C，多云）
# - 用户/衣物/穿搭等数据使用本地模拟数据
# - 所有 API 调用会有轻微延迟以模拟网络请求
#
# 真实后端模式：
# - 需要启动后端服务 (cd service && uvicorn app.main:app --reload)
# - 需要配置 QWEATHER_API_KEY 以获取真实天气数据
